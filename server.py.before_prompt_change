def load_default_story_files():
    result = []
    for name in STORY_NAMES:
        path = STORY_DIR / name
        if path.exists():
            try:
                result.append((name, path.read_text(encoding="utf-8")))
            except Exception as exc:
                result.append((name, json.dumps({"_error": str(exc)})))
    return result

class Handler(BaseHTTPRequestHandler):
    def _json(self, status, data):
        raw = json.dumps(data, ensure_ascii=False).encode("utf-8")
        try:
            self.send_response(status)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(raw)
        except BrokenPipeError:
            pass

    def _body(self):
        n = int(self.headers.get("Content-Length", "0"))
        return json.loads(self.rfile.read(n) or b"{}")

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/api/status":
            files = load_default_story_files()
            self._json(200, {
                "running": bool(session.child and session.child.poll() is None),
                "model": str(MODEL),
                "llama": str(LLAMA),
                "files": [{"name": n, "loaded": True} for n, _ in files],
                "story_dir": str(STORY_DIR),
                "context_size": 12288,
                "gpu_layers": 0,
            })
            return
        if path == "/api/default-files":
            files = load_default_story_files()
            self._json(200, {"files": [{"name": n, "content": c} for n, c in files]})
            return
        if path == "/":
            path = "/index.html"
        file_path = Path(__file__).parent / "static" / path.lstrip("/")
        if file_path.exists() and file_path.is_file():
            content_type = "text/html; charset=utf-8" if file_path.suffix == ".html" else "text/css; charset=utf-8" if file_path.suffix == ".css" else "application/javascript; charset=utf-8"
            raw = file_path.read_bytes()
            try:
                self.send_response(200)
                self.send_header("Content-Type", content_type)
                self.send_header("Content-Length", str(len(raw)))
                self.send_header("Cache-Control", "no-store, no-cache, must-revalidate")
                self.end_headers()
                self.wfile.write(raw)
            except BrokenPipeError:
                pass
            return
        self._json(404, {"error": "Not found"})

    def do_POST(self):
        path = urlparse(self.path).path
        try:
            body = self._body()
            if path == "/api/start":
                files = []
                for item in body.get("files", []):
                    name = str(item.get("name", "unnamed.json"))[:120]
                    content = str(item.get("content", ""))
                    files.append((name, content))
                if not files:
                    files = load_default_story_files()
                system_prompt = str(body.get("systemPrompt", SYSTEM_PROMPT))
                session.start(system_prompt, files)
                self._json(200, {"ok": True, "files": [n for n, _ in files], "estimated_system_tokens": session.estimate_context(), "context_size": 12288})
                return
            if path == "/api/chat":
                text = str(body.get("message", "")).strip()
                if not text:
                    self._json(400, {"error": "Message is empty"})
                    return
                started = time.time()
                answer, measured = session.ask(text)
                elapsed = measured
                self._json(200, {
                    "ok": True,
                    "content": answer,
                    "seconds": round(elapsed, 1),
                    "estimated_context_tokens": session.estimate_context(text + "\n" + answer),
                    "context_size": 12288,
                })
                return
            if path == "/api/stop":
                session.stop()
                self._json(200, {"ok": True})
                return
            self._json(404, {"error": "Not found"})
        except Exception as exc:
            self._json(500, {"error": str(exc)})

    def log_message(self, fmt, *args):
        print(f"[{time.strftime('%H:%M:%S')}] {fmt % args}")

def _open_browser_when_ready():
    url = f"http://{HOST}:{PORT}"
    for _ in range(50):
        try:
            with socket.create_connection((HOST, PORT), timeout=0.25):
                webbrowser.open(url, new=2)
                return
        except OSError:
            time.sleep(0.1)

def main():
    httpd = ThreadingHTTPServer((HOST, PORT), Handler)
    print(f"Local Story Chat: http://{HOST}:{PORT}")
    print(f"llama-cli: {LLAMA}")
    print(f"model: {MODEL}")
    print("Browser will open automatically.")
    print("Press Ctrl+C to stop the web app.")
    threading.Thread(target=_open_browser_when_ready, name="browser-opener", daemon=True).start()
    try:
        httpd.serve_forever()
    finally:
        session.stop()
        httpd.server_close()

if __name__ == "__main__":
    main()
