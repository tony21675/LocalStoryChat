<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Local Story Chat</title>
<style>
:root{--bg:#0f1115;--panel:#171a21;--panel2:#1e232c;--text:#f3f5f7;--muted:#9aa4b2;--line:#2d3440;--accent:#7dd3fc;--danger:#fb7185;}
*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
main{width:min(100%,980px);margin:0 auto;padding:18px;display:flex;flex-direction:column;min-height:100vh}
header{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding-bottom:14px;border-bottom:1px solid var(--line)}
h1{font-size:20px;margin:0 0 4px} .sub{color:var(--muted);font-size:13px}
.toolbar{display:flex;flex-wrap:wrap;gap:8px}.btn{border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:10px;padding:9px 12px;cursor:pointer;font-weight:600}.btn:hover{border-color:#465264}.btn.primary{border-color:#3a6577;background:#163340}.btn.danger{border-color:#6b2636;background:#341820}
.status{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0;color:var(--muted);font-size:12px}.pill{background:var(--panel);border:1px solid var(--line);padding:7px 9px;border-radius:999px}.pill strong{color:var(--text)}
.files{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:12px}.files h2{font-size:14px;margin:0 0 8px}.file-list{display:flex;flex-wrap:wrap;gap:7px}.file{font-size:12px;color:#d8dee7;background:#12151a;border:1px solid var(--line);padding:6px 8px;border-radius:8px}.file.loaded{border-color:#355769}
.chat{flex:1;display:flex;flex-direction:column;gap:12px;padding:8px 0 14px}.msg{max-width:86%;padding:12px 14px;border-radius:14px;white-space:pre-wrap;line-height:1.5}.user{align-self:flex-end;background:#21313b;border:1px solid #314958}.assistant{align-self:flex-start;background:var(--panel);border:1px solid var(--line)}
.empty{color:var(--muted);padding:26px;text-align:center;border:1px dashed var(--line);border-radius:14px}
.composer{position:sticky;bottom:0;background:linear-gradient(to top,var(--bg) 80%,transparent);padding-top:12px}.row{display:flex;gap:8px;align-items:flex-end}textarea{flex:1;min-height:56px;max-height:180px;resize:vertical;background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:12px;font:inherit;font-size:16px}textarea:focus{outline:2px solid #34576a;border-color:#5a8ba3}.send{min-height:56px;padding:0 18px}.note{font-size:11px;color:var(--muted);margin-top:7px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
pre{white-space:pre-wrap;overflow-wrap:anywhere}.error{color:#fecdd3;background:#2b151b;border:1px solid #6b2636;padding:10px;border-radius:10px}
@media(max-width:640px){main{padding:12px}.msg{max-width:94%}.toolbar{width:100%}.toolbar .btn{flex:1}.row{flex-direction:column}.send{width:100%}}
</style>
</head>
<body>
<main>
<header>
<div><h1>Local Story Chat</h1><div class="sub">Persistent Dolphin 8B chat via llama-cli. Browser UI stays local.</div></div>
<div class="toolbar"><button id="newChat" class="btn primary">New Chat</button><button id="stop" class="btn danger">Stop</button></div>
</header>
<div class="status"><div class="pill">Backend: <strong id="backend">checking…</strong></div><div class="pill">GPU layers: <strong>0</strong></div><div class="pill">Context: <strong>12288</strong></div><div class="pill">Files: <strong id="fileCount">0</strong></div></div>
<section class="files"><h2>Story reference files</h2><div id="fileList" class="file-list"></div></section>
<section id="chat" class="chat"><div class="empty" id="empty">Start a new chat to load the six story files into the persistent Dolphin session.</div></section>
<section class="composer"><div class="row"><textarea id="input" placeholder="Write to the story engine…"></textarea><button id="send" class="btn primary send">Send</button></div><div class="note"><span>Estimated context uses ~4 chars/token. llama.cpp remains authoritative.</span><span id="timing"></span></div></section>
</main>
<script>
const $=s=>document.querySelector(s); const chat=$('#chat'), input=$('#input');
function addMsg(role,text){const d=document.createElement('div');d.className='msg '+role;d.textContent=text;chat.appendChild(d);d.scrollIntoView({block:'end'});const e=$('#empty');if(e)e.remove();return d}
function showError(t){const d=document.createElement('div');d.className='error';d.textContent=t;chat.appendChild(d);d.scrollIntoView({block:'end'})}
async function api(path,opts={}){const r=await fetch(path,{headers:{'Content-Type':'application/json'},...opts});const j=await r.json();if(!r.ok)throw new Error(j.error||'Request failed');return j}
async function refresh(){try{const s=await api('/api/status');$('#backend').textContent=s.running?'running':'stopped';const list=$('#fileList');list.innerHTML='';s.files.forEach(f=>{const d=document.createElement('div');d.className='file loaded';d.textContent=f.name;list.appendChild(d)});$('#fileCount').textContent=s.files.length}catch(e){$('#backend').textContent='error';showError(e.message)}}
async function start(){
 $('#newChat').disabled=true; $('#backend').textContent='starting…';
 try{const f=await api('/api/default-files');const j=await api('/api/start',{method:'POST',body:JSON.stringify({files:f.files})});
 addMsg('assistant','New persistent session loaded with: '+j.files.join(', ')+'.');$('#timing').textContent='System prompt estimate: '+j.estimated_system_tokens+' tokens';await refresh();
 }catch(e){showError(e.message);$('#backend').textContent='error'}finally{$('#newChat').disabled=false}
}
async function send(){const text=input.value.trim();if(!text)return;input.value='';addMsg('user',text);$('#send').disabled=true;$('#newChat').disabled=true;try{const j=await api('/api/chat',{method:'POST',body:JSON.stringify({message:text})});addMsg('assistant',j.content);$('#timing').textContent=j.seconds+' s • estimated context '+j.estimated_context_tokens+'/12288'}catch(e){showError(e.message)}finally{$('#send').disabled=false;$('#newChat').disabled=false;input.focus()}}
$('#newChat').addEventListener('click',start);$('#stop').addEventListener('click',async()=>{try{await api('/api/stop',{method:'POST'});$('#backend').textContent='stopped'}catch(e){showError(e.message)}});$('#send').addEventListener('click',send);input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send()}});refresh();
</script>
</body>
</html>
