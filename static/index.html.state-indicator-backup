<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Local Story Chat</title>
<style>
:root{--bg:#0f1115;--panel:#171a21;--panel2:#1e232c;--text:#f3f5f7;--muted:#9aa4b2;--line:#2d3440;--accent:#7dd3fc;--danger:#fb7185;--ok:#86efac}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
main{width:min(100%,980px);margin:0 auto;padding:18px;display:flex;flex-direction:column;min-height:100vh}
header{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;padding-bottom:14px;border-bottom:1px solid var(--line)}
h1{font-size:20px;margin:0 0 4px}
.sub{color:var(--muted);font-size:13px}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end}
.btn{border:1px solid var(--line);background:var(--panel2);color:var(--text);border-radius:10px;padding:9px 12px;cursor:pointer;font-weight:600}
.btn:hover{border-color:#465264}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.primary{border-color:#3a6577;background:#163340}
.btn.danger{border-color:#6b2636;background:#341820}
.btn.ok{border-color:#355f4a;background:#183024}
.status{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0;color:var(--muted);font-size:12px}
.pill{background:var(--panel);border:1px solid var(--line);padding:7px 9px;border-radius:999px}
.pill strong{color:var(--text)}
.controls{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:8px;margin-bottom:12px}
select{min-width:0;width:100%;background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:10px;padding:10px;font:inherit}
.files{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:12px}
.files-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:8px}
.files h2{font-size:14px;margin:0}
.file-list{display:flex;flex-wrap:wrap;gap:7px}
.file{font-size:12px;color:#d8dee7;background:#12151a;border:1px solid var(--line);padding:6px 8px;border-radius:8px}
.file.loaded{border-color:#355769}
.file.none{color:var(--muted);border-style:dashed}
.chat{flex:1;display:flex;flex-direction:column;gap:12px;padding:8px 0 14px}
.msg{max-width:86%;padding:12px 14px;border-radius:14px;white-space:pre-wrap;line-height:1.5}
.user{align-self:flex-end;background:#21313b;border:1px solid #314958}
.assistant{align-self:flex-start;background:var(--panel);border:1px solid var(--line)}
.empty{color:var(--muted);padding:26px;text-align:center;border:1px dashed var(--line);border-radius:14px}
.composer{position:sticky;bottom:0;background:linear-gradient(to top,var(--bg) 80%,transparent);padding-top:12px}
.row{display:flex;gap:8px;align-items:flex-end}
textarea{flex:1;min-height:56px;max-height:180px;resize:vertical;background:var(--panel);color:var(--text);border:1px solid var(--line);border-radius:12px;padding:12px;font:inherit;font-size:16px}
textarea:focus{outline:2px solid #34576a;border-color:#5a8ba3}
.send{min-height:56px;padding:0 18px}
.note{font-size:11px;color:var(--muted);margin-top:7px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.error{color:#fecdd3;background:#2b151b;border:1px solid #6b2636;padding:10px;border-radius:10px}
@media(max-width:760px){
  main{padding:12px}
  .toolbar{width:100%;justify-content:stretch}
  .toolbar .btn{flex:1}
  header{flex-direction:column}
  .controls{grid-template-columns:1fr}
  .msg{max-width:94%}
  .row{flex-direction:column}
  .send{width:100%}
}
</style>
</head>
<body>
<main>
<header>
  <div>
    <h1>Local Story Chat</h1>
    <div class="sub">Local llama-cli story writer. JSON reference files and model are managed separately from the chat.</div>
  </div>

  <div class="toolbar">
    <button id="newChat" class="btn primary">New Chat</button>
    <button id="stop" class="btn danger">Stop</button>
  </div>
</header>

<div class="status">
  <div class="pill">Backend: <strong id="backend">checking…</strong></div>
  <div class="pill">Model: <strong id="modelStatus">none</strong></div>
  <div class="pill">JSON: <strong id="fileCount">0</strong> loaded</div>
  <div class="pill">Context: <strong>12288</strong></div>
  <div class="pill">Thinking: <strong>off</strong></div><div class="pill">State: <strong id="stateStatus">checking…</strong></div>
</div>

<section class="files">
  <div class="files-head">
    <h2>Model</h2>
  </div>

  <div class="controls">
    <select id="modelSelect" aria-label="Select model">
      <option value="">Loading models…</option>
    </select>

    <button id="loadModel" class="btn ok">Load Model</button>
    <button id="unloadModel" class="btn danger">Unload Model</button>
  </div>
</section>

<section class="files">
  <div class="files-head">
    <h2>Story reference files</h2>

    <div class="toolbar">
      <button id="loadJson" class="btn ok">Load JSON</button>
      <button id="unloadJson" class="btn danger">Unload JSON</button>
    </div>
  </div>

  <div id="fileList" class="file-list"></div>
</section>

<section class="files">
  <div class="files-head">
    <h2>Story state</h2>
    <div class="toolbar">
      <button id="updateState" class="btn ok">Update State</button>
      <button id="applyState" class="btn primary" disabled>Apply State</button>
      <button id="discardState" class="btn danger" disabled>Discard</button>
      <label class="btn" for="sectionFile" style="display:inline-flex;align-items:center;cursor:pointer">
        Select Section File
      </label>
      <input id="sectionFile" type="file" accept=".txt,text/plain" hidden>
      <button id="updateFromFile" class="btn ok" disabled>Update From File</button>
    </div>
  </div>

  <div class="sub" style="margin-bottom:8px">
    Update State uses the latest assistant story response. It proposes changes for review before anything is written to disk.
  </div>

  <textarea id="statePreview" rows="14" readonly
    placeholder="A proposed current_state.json will appear here."></textarea>
</section>

<section id="chat" class="chat">
  <div class="empty" id="empty">
    Load a model and JSON files, then click New Chat.
  </div>
</section>

<section class="composer">
  <div class="row">
    <textarea id="input" placeholder="Write to the story engine…"></textarea>
    <button id="send" class="btn primary send">Send</button>
  </div>

  <div class="note">
    <span>CPU mode • 12,288 context • repetition penalty 1.08 • reasoning off</span>
    <span id="timing"></span>
  </div>
</section>
</main>

<script>
const $=s=>document.querySelector(s);
const chat=$('#chat');
const input=$('#input');

let pendingState=null;
function addMsg(role,text){
  const d=document.createElement('div');
  d.className='msg '+role;
  d.textContent=text;
  chat.appendChild(d);
  d.scrollIntoView({block:'end'});

  const e=$('#empty');
  if(e)e.remove();

  return d;
}

function clearChat(){
  chat.innerHTML='<div class="empty" id="empty">New chat. No previous conversation is loaded.</div>';
  $('#timing').textContent='';
}

function showError(t){
  const d=document.createElement('div');
  d.className='error';
  d.textContent=t;
  chat.appendChild(d);
  d.scrollIntoView({block:'end'});
}

async function api(path,opts={}){
  const r=await fetch(path,{
    headers:{'Content-Type':'application/json'},
    ...opts
  });

  const j=await r.json();

  if(!r.ok)throw new Error(j.error||'Request failed');

  return j;
}

function setBusy(value){
  $('#newChat').disabled=value;
  $('#stop').disabled=value;
  $('#loadModel').disabled=value;
  $('#unloadModel').disabled=value;
  $('#loadJson').disabled=value;
  $('#unloadJson').disabled=value;
  $('#send').disabled=value;
  $('#updateState').disabled=value;
  $('#updateFromFile').disabled=value || !selectedSectionFile;
  $('#applyState').disabled=value || !pendingState;
  $('#discardState').disabled=value || !pendingState;
}

function renderFiles(files){
  const list=$('#fileList');
  list.innerHTML='';

  if(!files.length){
    const d=document.createElement('div');
    d.className='file none';
    d.textContent='No JSON files loaded';
    list.appendChild(d);
    return;
  }

  files.forEach(f=>{
    const d=document.createElement('div');
    d.className='file loaded';
    d.textContent=f.name;
    list.appendChild(d);
  });
}

async function refresh(){
  try{
    const s=await api('/api/status');

    $('#backend').textContent=s.running?'running':'stopped';
    $('#modelStatus').textContent=s.model?s.model.split('/').pop():'none';
    $('#fileCount').textContent=s.files.length;

    if(s.state){
      $('#stateStatus').textContent =
        'Ch '+s.state.chapter+' / Sc '+s.state.scene+
        (s.state.pending?' • proposal':'');
    }

    renderFiles(s.files);

    const select=$('#modelSelect');
    const current=select.value;

    select.innerHTML='';

    if(!s.available_models.length){
      const o=document.createElement('option');
      o.value='';
      o.textContent='No GGUF models found';
      select.appendChild(o);
    }else{
      s.available_models.forEach(m=>{
        const o=document.createElement('option');
        o.value=m.path;
        o.textContent=m.name;
        select.appendChild(o);
      });

      if(s.model){
        select.value=s.model;
      }else if(current){
        select.value=current;
      }
    }
  }catch(e){
    $('#backend').textContent='error';
    showError(e.message);
  }
}

async function loadModel(){
  const path=$('#modelSelect').value;

  if(!path){
    showError('Select a GGUF model first.');
    return;
  }

  setBusy(true);
  $('#backend').textContent='loading model…';

  try{
    const j=await api('/api/model/load',{
      method:'POST',
      body:JSON.stringify({path})
    });

    clearChat();

    addMsg(
      'assistant',
      'Model loaded: '+j.model.split('/').pop()+
      '. Start a New Chat to begin a fresh session.'
    );

    await refresh();
  }catch(e){
    showError(e.message);
    $('#backend').textContent='error';
  }finally{
    setBusy(false);
  }
}

async function unloadModel(){
  setBusy(true);

  try{
    await api('/api/model/unload',{
      method:'POST',
      body:JSON.stringify({})
    });

    clearChat();
    addMsg('assistant','Model unloaded. The GGUF file remains on disk.');
    await refresh();
  }catch(e){
    showError(e.message);
  }finally{
    setBusy(false);
  }
}

async function loadJson(){
  setBusy(true);

  try{
    const j=await api('/api/json/load',{
      method:'POST',
      body:JSON.stringify({})
    });

    clearChat();

    addMsg(
      'assistant',
      'Loaded JSON files: '+j.files.join(', ')+
      '. Click New Chat to start a fresh model session.'
    );

    await refresh();
  }catch(e){
    showError(e.message);
  }finally{
    setBusy(false);
  }
}

async function unloadJson(){
  setBusy(true);

  try{
    await api('/api/json/unload',{
      method:'POST',
      body:JSON.stringify({})
    });

    clearChat();
    addMsg(
      'assistant',
      'JSON reference files unloaded from the active session. The files were not deleted.'
    );

    await refresh();
  }catch(e){
    showError(e.message);
  }finally{
    setBusy(false);
  }
}


function latestAssistantText(){
  const items=chat.querySelectorAll('.msg.assistant');
  if(!items.length)return '';
  return items[items.length-1].textContent.trim();
}

function selectSectionFile(){
  const file=$('#sectionFile').files[0] || null;
  selectedSectionFile=file;
  const button=$('#updateFromFile');

  if(file){
    button.disabled=false;
    $('#stateStatus').textContent='section selected: '+file.name;
  }else{
    button.disabled=true;
  }
}

async function updateStateFromFile(){
  if(!selectedSectionFile){
    showError('Select a .txt section file first.');
    return;
  }

  setBusy(true);

  try{
    const story=(await selectedSectionFile.text()).trim();

    if(story.length < 40){
      throw new Error('The selected section file is too short to create a useful state update.');
    }

    const j=await api('/api/state/propose',{
      method:'POST',
      body:JSON.stringify({story})
    });

    pendingState=j.state;
    $('#statePreview').value=JSON.stringify(j.state,null,2);
    $('#stateStatus').textContent='proposal ready from '+selectedSectionFile.name;
  }catch(e){
    showError(e.message);
  }finally{
    setBusy(false);
  }
}

async function updateState(){
  const story=latestAssistantText();

  if(!story){
    showError('There is no assistant story response to use for a state update.');
    return;
  }

  setBusy(true);

  try{
    const j=await api('/api/state/propose',{
      method:'POST',
      body:JSON.stringify({story})
    });

    pendingState=j.state;
    $('#statePreview').value=JSON.stringify(j.state,null,2);
    $('#stateStatus').textContent='proposal ready';
  }catch(e){
    showError(e.message);
  }finally{
    setBusy(false);
  }
}

async function applyState(){
  if(!pendingState)return;

  setBusy(true);

  try{
    const j=await api('/api/state/apply',{
      method:'POST',
      body:JSON.stringify({})
    });

    pendingState=null;
    $('#statePreview').value='';
    $('#stateStatus').textContent='applied';
    addMsg('assistant',j.message);
    await refresh();
  }catch(e){
    showError(e.message);
  }finally{
    setBusy(false);
  }
}

async function discardState(){
  try{
    await api('/api/state/discard',{
      method:'POST',
      body:JSON.stringify({})
    });

    pendingState=null;
    $('#statePreview').value='';
    $('#stateStatus').textContent='no proposal';
    setBusy(false);
  }catch(e){
    showError(e.message);
  }
}

async function newChat(){
  setBusy(true);
  $('#backend').textContent='starting…';

  try{
    const j=await api('/api/new-chat',{
      method:'POST',
      body:JSON.stringify({})
    });

    clearChat();

    addMsg(
      'assistant',
      'New chat started with '+
      j.model.split('/').pop()+
      ' and '+
      j.files.length+
      ' JSON reference files.'
    );

    $('#timing').textContent=
      'System prompt estimate: '+
      j.estimated_system_tokens+
      ' tokens';

    await refresh();
  }catch(e){
    showError(e.message);
    $('#backend').textContent='error';
  }finally{
    setBusy(false);
    input.focus();
  }
}

async function stopSession(){
  try{
    await api('/api/stop',{
      method:'POST',
      body:JSON.stringify({})
    });

    $('#backend').textContent='stopped';
    addMsg('assistant','Model session stopped. Loaded model and JSON selections remain available.');
    await refresh();
  }catch(e){
    showError(e.message);
  }
}

async function send(){
  const text=input.value.trim();

  if(!text)return;

  input.value='';
  addMsg('user',text);

  $('#send').disabled=true;
  $('#newChat').disabled=true;

  try{
    const j=await api('/api/chat',{
      method:'POST',
      body:JSON.stringify({message:text})
    });

    addMsg('assistant',j.content);

    $('#timing').textContent=
      j.seconds+
      ' s • estimated context '+
      j.estimated_context_tokens+
      '/12288';
  }catch(e){
    showError(e.message);
  }finally{
    $('#send').disabled=false;
    $('#newChat').disabled=false;
    input.focus();
  }
}

$('#newChat').addEventListener('click',newChat);
$('#stop').addEventListener('click',stopSession);
$('#loadModel').addEventListener('click',loadModel);
$('#unloadModel').addEventListener('click',unloadModel);
$('#loadJson').addEventListener('click',loadJson);
$('#unloadJson').addEventListener('click',unloadJson);
$('#send').addEventListener('click',send);
$('#updateState').addEventListener('click',updateState);
$('#updateFromFile').addEventListener('click',updateStateFromFile);
$('#sectionFile').addEventListener('change',selectSectionFile);
$('#applyState').addEventListener('click',applyState);
$('#discardState').addEventListener('click',discardState);

input.addEventListener('keydown',e=>{
  if(e.key==='Enter'&&!e.shiftKey){
    e.preventDefault();
    send();
  }
});

refresh();
</script>
</body>
</html>
